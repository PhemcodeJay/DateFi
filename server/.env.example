# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/datefi

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Upload Configuration
UPLOAD_PATH=./uploads
MEDIA_UPLOAD_PATH=./uploads/media
MAX_FILE_SIZE=104857600

# NowPayments (Crypto Payments)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET_KEY=your-ipn-secret-key
NOWPAYMENTS_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook
